# EchoDesk Agent configuration
# Copy this file to `.env` in the same directory (agent/.env) and fill it in.

# --- Backend connection (required) ---
ECHODESK_BACKEND_URL=
ECHODESK_API_PREFIX=/api/v1
ECHODESK_VERIFY_TLS=true

# --- Auth: option 1 (recommended) - pre-provisioned device API key ---
# Mint this by calling POST /devices/{id}/api-key while logged in as the
# owner (after registering the device once), then paste the raw key below.
# Format is "prefix.secret" - shown only once at creation time.
ECHODESK_API_KEY=

# --- Auth: option 2 - one-time bootstrap (first run only) ---
# If ECHODESK_API_KEY is empty, the Agent will use these to log in once,
# register itself, and mint its own API key (saved to device_credentials.json
# next to this file). Remove these two lines after the first successful run.
ECHODESK_EMAIL=
ECHODESK_PASSWORD=

# --- Device identity ---
# Leave ECHODESK_DEVICE_NAME empty to default to the machine's hostname.
ECHODESK_DEVICE_NAME=
ECHODESK_DEVICE_TYPE=desktop

# --- Timing ---
ECHODESK_HEARTBEAT_INTERVAL=30
ECHODESK_REST_TIMEOUT=15

# --- Storage ---
# Defaults to the agent/ install directory if unset.
ECHODESK_DATA_DIR=
ECHODESK_LOG_DIR=
ECHODESK_LOG_LEVEL=INFO

# --- File manager ---
# If set, restricts FILE_LIST/DOWNLOAD/UPLOAD/DELETE_FILE requests to paths
# under this directory (recommended). Leave empty to allow the OS user's full
# filesystem permissions (still bounded by the OS account the Agent runs as).
ECHODESK_FILE_ROOT=
