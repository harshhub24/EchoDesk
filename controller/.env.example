# EchoDesk Desktop Controller configuration
# Copy this file to `.env` next to main.py and fill it in.

ECHODESK_BACKEND_URL=
ECHODESK_API_PREFIX=/api/v1
ECHODESK_VERIFY_TLS=true

ECHODESK_REST_TIMEOUT=15
ECHODESK_DEVICE_POLL_INTERVAL=30
ECHODESK_COMMAND_POLL_INTERVAL=5

# Defaults to the controller/ install directory if unset.
ECHODESK_DATA_DIR=
ECHODESK_LOG_DIR=
ECHODESK_LOG_LEVEL=INFO

# Whether the "Remember Login" checkbox on the Login page defaults to checked.
ECHODESK_REMEMBER_LOGIN_DEFAULT=true

# dark | light (dark is the only fully designed theme in this build; light
# is reserved for a future pass - see docs/CHANGELOG.md)
ECHODESK_THEME=dark